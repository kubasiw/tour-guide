{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start"],
      "port": 4200
    },
    {
      "name": "portfolio-shell-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/portfolio-shell", "run", "dev"],
      "port": 5173
    },
    {
      "name": "portfolio-shell-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/portfolio-shell", "run", "preview", "--", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start:dev"],
      "port": 3000
    },
    {
      "name": "mini-map-widget-test",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "frontend/dist/frontend-element/browser", "-l", "4300"],
      "port": 4300
    },
    {
      "name": "insider-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "C:/insider", "run", "dev"],
      "port": 5180
    }
  ]
}

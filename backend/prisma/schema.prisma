// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  plans               Plan[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Plan {
  id                       String          @id @default(uuid())
  userId                   String?
  user                     User?           @relation(fields: [userId], references: [id])
  status                   String          @default("draft")
  area                     Area?
  activities               String[]        @default([])
  startDate                DateTime?
  durationDays             Int?
  items                    PlanItem[]
  trailItems               PlanTrailItem[]
  aiDescription            String?
  aiDescriptionGeneratedAt DateTime?
  themePreset              String?
  createdAt                DateTime        @default(now())
}

model Area {
  id        String   @id @default(uuid())
  planId    String   @unique
  plan      Plan     @relation(fields: [planId], references: [id])
  geometry  Json
  createdAt DateTime @default(now())
}

model Poi {
  id                       String     @id @default(uuid())
  osmId                    String     @unique
  name                     String
  type                     String
  lat                      Float
  lng                      Float
  openingHours             String?
  sourceData               Json
  aiDescription            String?
  aiDescriptionGeneratedAt DateTime?
  planItems                PlanItem[]
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

model PlanItem {
  id           String   @id @default(uuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id])
  poiId        String
  poi          Poi      @relation(fields: [poiId], references: [id])
  order        Int
  dayNumber    Int?
  note         String?
  userModified Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([planId, poiId])
}

// A deliberately separate model from `PlanItem` rather than a polymorphic
// poiId/trailId union on it — trails have their own small "Twoje szlaki"
// list next to "Twój plan", not interleaved/drag-reordered together with
// POIs (confirmed via AskUserQuestion, 2026-07-23: smaller, safer change
// that doesn't touch the existing, working POI plan-item/reorder code).
model Trail {
  id             String          @id @default(uuid())
  osmId          String          @unique
  name           String
  ref            String?
  colour         String?
  distanceKm     Float?
  planTrailItems PlanTrailItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PlanTrailItem {
  id        String   @id @default(uuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  trailId   String
  trail     Trail    @relation(fields: [trailId], references: [id])
  order     Int
  createdAt DateTime @default(now())

  @@unique([planId, trailId])
}
